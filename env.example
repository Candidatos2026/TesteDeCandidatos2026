# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com as chaves de verdade) para o GitHub.

# Painel do Mercado Pago > Suas integrações > Credenciais de produção
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI

# URL do seu site (onde o index.html está publicado)
SITE_URL=https://seusite.com.br

# URL pública deste backend (precisa ser acessível pela internet
# para o Mercado Pago conseguir chamar o webhook — em desenvolvimento
# local, use algo como ngrok para gerar uma URL temporária)
BACKEND_URL=https://seu-backend.com.br

PORT=3001
